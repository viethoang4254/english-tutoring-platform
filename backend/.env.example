# Required process variables; placeholders only. Spring Boot does not load this file.
# Set values in your backend shell; never put passwords in DATABASE_URL.
# Local URL shape: jdbc:postgresql://localhost:5432/<DATABASE>
# Supabase: use the dashboard Session Pooler host, port 5432 and its username.
# URL shape: jdbc:postgresql://<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
# require mandates TLS but does not verify certificate/hostname; no custom CA required.
DATABASE_URL=<CREDENTIAL_FREE_JDBC_URL>
DATABASE_USERNAME=<DATABASE_USERNAME>
DATABASE_PASSWORD=<DATABASE_PASSWORD>
